{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "eslint.config.mjs", "jest.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
