# =========================================================================
# Formz — konfigurasi produksi (server Ubuntu self-hosted)
#
# Cara pakai:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano .env.production        # ganti semua nilai "ganti-dengan-..."
#
# JANGAN commit .env.production (sudah masuk .gitignore).
# Generate setiap secret dengan nilai acak yang BERBEDA:
#   openssl rand -hex 32
#
# Berkas ini dibaca docker-compose.prod.yml lewat `--env-file`, dan juga oleh
# deploy.sh serta backup.sh. Variabel yang ditandai (build) tertanam di bundle
# browser saat image dibangun — mengubahnya menuntut deploy ulang, bukan restart.
# =========================================================================

# ---------- Umum ----------
COMPOSE_PROJECT_NAME=formz
# Zona waktu server. Timestamp di database tetap disimpan UTC apa pun isinya —
# ini hanya memengaruhi tampilan jam di log container.
TZ=Asia/Jakarta
# Tag image yang dibangun deploy.sh. Biarkan `latest` untuk pemakaian biasa;
# isi dengan nomor rilis kalau ingin bisa kembali ke image sebelumnya.
IMAGE_TAG=latest

# ---------- Domain (build untuk APP/API/EMBED) ----------
# Ketiganya WAJIB sudah mengarah ke IP server ini sebelum stack dinyalakan.
# Caddy menerbitkan sertifikat Let's Encrypt untuk ketiganya saat start pertama,
# dan penerbitan itu gagal kalau DNS-nya belum menunjuk ke sini.
APP_DOMAIN=app.namadomain.com
API_DOMAIN=api.namadomain.com
EMBED_DOMAIN=embed.namadomain.com
# Alamat pemberitahuan Let's Encrypt (sertifikat gagal diperpanjang, dll).
# Pakai alamat yang benar-benar dibaca orang.
ACME_EMAIL=admin@namadomain.com

# ---------- PostgreSQL ----------
POSTGRES_DB=formz
POSTGRES_USER=formz
# Kalau password mengandung @ : / ? # , tulis versi URL-encoded-nya —
# nilainya disusun jadi connection string oleh compose.
POSTGRES_PASSWORD=ganti-dengan-password-postgres-acak
POSTGRES_POOL_MAX=10

# ---------- Redis ----------
REDIS_PASSWORD=ganti-dengan-password-redis-acak
REDIS_DB=0

# ---------- Worker ----------
# Berapa job diproses bersamaan per queue. Naikkan kalau antrean sering menumpuk
# dan server masih lapang; turunkan kalau Postgres yang jadi bottleneck.
WORKER_CONCURRENCY=5

# ---------- Auth ----------
# WAJIB berbeda satu sama lain, dan berbeda dari nilai di server development.
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
JWT_REFRESH_SECRET=ganti-dengan-hasil-openssl-rand-hex-32-yang-berbeda
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- User admin pertama (dibuat oleh seed) ----------
# Password ini hanya dipakai saat user pertama kali dibuat; seed berikutnya
# tidak menimpanya. Ganti lewat dashboard setelah login pertama, lalu boleh
# dikosongkan di sini.
ADMIN_EMAIL=admin@namadomain.com
ADMIN_PASSWORD=ganti-dengan-password-admin-min-12-karakter
ADMIN_NAME="Super Admin"

# ---------- Reverse proxy ----------
# WAJIB true di produksi. API berada di belakang Caddy, dan tanpa ini setiap
# submission tercatat ber-IP gateway Docker — rate limit per IP pun berubah jadi
# rate limit global yang bisa dihabiskan satu pengirim spam.
# Sebaliknya, JANGAN pernah true kalau API dibuka langsung tanpa proxy:
# siapa pun bisa memalsukan X-Forwarded-For dan lolos rate limit.
TRUST_PROXY=true

# ---------- Endpoint publik (/public/*) ----------
PUBLIC_SCHEMA_CACHE_TTL=300
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# ---------- MinIO / object storage ----------
MINIO_ROOT_USER=formz-minio
MINIO_ROOT_PASSWORD=ganti-dengan-password-minio-min-8-karakter
MINIO_BUCKET=formz-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------- Pengiriman email notifikasi ----------
# console = email hanya dicetak ke log worker, TIDAK dikirim ke mana pun.
# Bawaannya sengaja console supaya server yang belum dikonfigurasi tidak bisa
# mengirim email ke alamat sungguhan hanya karena ada variabel yang lupa diisi.
# Ganti jadi "smtp" setelah kredensial relay di bawah benar-benar diisi.
MAIL_PROVIDER=console
# Pakai SMTP relay pihak ketiga (Postmark / Amazon SES / SendGrid).
# JANGAN menjalankan mail server sendiri di server ini — reputasi IP baru
# membuat emailnya hampir pasti masuk folder spam.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
# true hanya untuk port 465 (TLS sejak awal). Port 587 memakai STARTTLS.
SMTP_SECURE=false
SMTP_USER=ganti-dengan-smtp-user
SMTP_PASSWORD=ganti-dengan-smtp-password
MAIL_FROM="Formz <no-reply@namadomain.com>"

# ---------- Google Sheets ----------
# Service account, bukan OAuth per pengguna:
#   1. Buat project di Google Cloud Console, aktifkan "Google Sheets API"
#   2. Buat Service Account, lalu key bertipe JSON
#   3. Salin "client_email" dan "private_key" dari berkas JSON itu ke bawah ini
#   4. Buka spreadsheet tujuan → Share → tambahkan alamat service account
#      sebagai Editor. Tanpa langkah ini sync gagal dengan 403.
# Kosongkan keduanya kalau instalasi ini tidak memakai integrasi spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key satu baris; newline asli ditulis sebagai \n. Tanda kutip di luar
# nilai boleh ada — dibuang otomatis oleh worker.
GOOGLE_PRIVATE_KEY=

# ---------- Reporting ----------
# Jadwal menghitung ulang materialized view laporan (cron 5 kolom).
REPORT_REFRESH_CRON=*/15 * * * *

# ---------- Bull Board (pemantauan antrean) ----------
# Terbuka di https://api.namadomain.com/queues dengan HTTP Basic auth.
# Halaman ini disajikan Express langsung sehingga tidak lewat JWT seperti
# endpoint /admin lainnya. Kalau user/password dikosongkan, halamannya TIDAK
# dipasang sama sekali — dan itu pilihan yang sah untuk produksi.
QUEUE_DASHBOARD_PATH=/queues
QUEUE_DASHBOARD_USER=queue-admin
QUEUE_DASHBOARD_PASSWORD=ganti-dengan-password-min-8-karakter

# =========================================================================
# Backup terjadwal (dibaca scripts/backup.sh, bukan docker compose)
# =========================================================================

# Folder penampung backup di server sebelum diunggah. Pastikan ada dan
# hanya bisa dibaca pemiliknya: mkdir -p /var/backups/formz && chmod 700 ...
BACKUP_DIR=/var/backups/formz
# Berapa hari salinan lokal disimpan. Salinan offsite diatur terpisah lewat
# retensi di sisi rclone (lihat scripts/backup.sh).
BACKUP_RETENTION_DAYS=7

# Nama remote rclone tujuan, sesuai isi scripts/rclone.conf.
# Kosongkan kalau untuk sementara hanya ingin backup lokal — skripnya tetap
# jalan dan hanya melewati langkah unggah, dengan peringatan di log.
RCLONE_REMOTE=offsite
RCLONE_PATH=formz
RCLONE_CONFIG=/home/formz/formz/scripts/rclone.conf

# Kirim ping ke URL ini setiap backup selesai (healthchecks.io, Uptime Kuma,
# atau layanan sejenis). Tanpa pemantauan semacam ini, backup yang berhenti
# berjalan baru ketahuan pada saat paling buruk: ketika datanya dibutuhkan.
# Kosongkan kalau belum dipakai.
BACKUP_PING_URL=
