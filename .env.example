# =========================================================================
# Formz — contoh konfigurasi environment
#
# Cara pakai:  cp .env.example .env  lalu ganti semua nilai "ganti-dengan-..."
# JANGAN commit file .env (sudah masuk .gitignore).
#
# Generate secret yang aman:  openssl rand -hex 32
# =========================================================================

# ---------- Umum ----------
NODE_ENV=development
TZ=Asia/Jakarta
COMPOSE_PROJECT_NAME=formz

# ---------- Port yang di-expose ke host ----------
API_PORT=4000
DASHBOARD_PORT=3000
EMBED_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=formz
POSTGRES_USER=formz
POSTGRES_PASSWORD=ganti-dengan-password-postgres
POSTGRES_POOL_MAX=10
# Dipakai Prisma CLI (migrate & seed). Di Docker nilai ini di-override compose
# supaya menunjuk ke host "postgres"; baris di bawah untuk menjalankan dari host.
# Kalau password mengandung @ : / ? # , tulis versi URL-encoded-nya.
DATABASE_URL=postgresql://formz:ganti-dengan-password-postgres@localhost:5432/formz

# ---------- Redis (cache + broker BullMQ) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ganti-dengan-password-redis
REDIS_DB=0

# ---------- Worker ----------
WORKER_CONCURRENCY=5

# ---------- URL antar service ----------
# Dipakai untuk CORS dashboard dan base URL yang dipanggil browser.
DASHBOARD_URL=http://localhost:3000
EMBED_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# ---------- Endpoint publik (/public/*) yang dipakai form renderer ----------
# Umur cache schema form di Redis, dalam detik. Cache dibatalkan lebih awal
# setiap kali form dipublish, whitelist domain diubah, atau form diarsipkan.
PUBLIC_SCHEMA_CACHE_TTL=300
# Batas request per menit per (formKey, IP) untuk seluruh endpoint publik.
# Kuota submit per jam diatur per form lewat form builder, bukan di sini.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# Nyalakan HANYA kalau API benar-benar di belakang reverse proxy yang menulis
# X-Forwarded-For (Caddy/Nginx). Kalau dinyalakan tanpa proxy, siapa pun bisa
# memalsukan IP-nya dan lolos rate limit.
TRUST_PROXY=false

# ---------- MinIO / object storage (S3-compatible) ----------
MINIO_ROOT_USER=formz-minio
MINIO_ROOT_PASSWORD=ganti-dengan-password-minio-min-8-karakter
MINIO_BUCKET=formz-uploads
# Endpoint yang dipakai dari dalam jaringan Docker
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------- User admin default (dibuat oleh seed) ----------
# Kalau dua variabel pertama dikosongkan, seed melewati pembuatan user admin
# dengan peringatan — service lain tetap jalan normal.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-admin-min-12-karakter
ADMIN_NAME=Super Admin

# ---------- Auth (dipakai mulai part RBAC) ----------
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
JWT_REFRESH_SECRET=ganti-dengan-hasil-openssl-rand-hex-32-yang-berbeda
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- SMTP / email notifikasi (dipakai mulai part notifikasi) ----------
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=ganti-dengan-smtp-user
SMTP_PASSWORD=ganti-dengan-smtp-password
MAIL_FROM=no-reply@example.com

# ---------- Google Sheets (dipakai mulai part integrasi spreadsheet) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=ganti-dengan-service-account@project.iam.gserviceaccount.com
# Private key satu baris; ganti newline asli menjadi \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nganti-dengan-private-key\n-----END PRIVATE KEY-----\n"
