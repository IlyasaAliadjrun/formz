// Skema database Formz.
//
// Konvensi:
// - Model & field pakai camelCase (idiomatik Prisma/TypeScript), dipetakan ke
//   tabel & kolom snake_case lewat @map/@@map supaya SQL mentah tetap enak dibaca.
// - Primary key pakai UUID, bukan auto-increment. Untuk `forms` ini penting:
//   `form_key` yang dipakai di URL publik harus tidak bisa ditebak (lihat
//   ARCHITECTURE.md bagian 3.2).
// - Semua timestamp pakai `timestamptz` supaya tidak ada ambiguitas zona waktu.
// - Kolom yang isinya bisa berubah bentuk (schema form, jawaban, config integrasi)
//   disimpan sebagai JSONB. Bentuk isinya divalidasi di aplikasi memakai schema Zod
//   dari @formz/shared, bukan oleh constraint database.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// Prisma 7 tidak lagi menerima `url` di sini — connection string untuk perintah
// migrate/introspect diambil dari prisma.config.ts, sedangkan koneksi runtime
// diberikan lewat driver adapter di PrismaService.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Disimpan selalu dalam huruf kecil; normalisasi dilakukan di aplikasi.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       UserRole[]
  createdForms Form[]    @relation("FormCreatedBy")

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique
  description String?
  /// Role bawaan sistem tidak boleh dihapus/di-rename lewat UI.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// Format `resource.action`, misal `form.create`. Dipakai langsung oleh CASL.
  key         String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Satu user boleh punya lebih dari satu role — composite PK yang menjamin
  // pasangan (user, role) tidak dobel, bukan membatasi jumlah role per user.
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Form & versioning schema
// ---------------------------------------------------------------------------

enum FormStatus {
  draft
  published
  archived

  @@map("form_status")
}

model Form {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Token acak untuk URL publik (`/f/{formKey}`). Bukan ID internal, supaya
  /// form lain tidak bisa ditebak dengan mengganti angka di URL.
  formKey     String     @unique @map("form_key")
  title       String
  description String?
  status      FormStatus @default(draft)
  /// Whitelist domain yang boleh meng-embed form ini. Array kosong = tanpa batasan.
  allowedDomains String[] @default([]) @map("allowed_domains")

  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy         User?              @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions          FormVersion[]
  submissions       Submission[]
  integrations      Integration[]
  notificationRules NotificationRule[]

  @@index([status])
  @@index([createdById])
  @@map("forms")
}

model FormVersion {
  id            String @id @default(uuid(7)) @db.Uuid
  formId        String @map("form_id") @db.Uuid
  /// Naik satu setiap kali draft dipublish. Versi lama tidak pernah ditimpa.
  versionNumber Int    @map("version_number")
  /// Definisi field + field type + options + conditions.
  /// Divalidasi dengan `formSchemaSchema` dari @formz/shared.
  schema        Json   @db.JsonB

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([formId, versionNumber])
  @@index([formId, publishedAt(sort: Desc)])
  @@map("form_versions")
}

// ---------------------------------------------------------------------------
// Submission
// ---------------------------------------------------------------------------

model Submission {
  id String @id @default(uuid(7)) @db.Uuid

  formId String @map("form_id") @db.Uuid
  /// Snapshot versi schema saat submission masuk. Wajib, supaya tampilan
  /// histori tidak ikut berubah kalau form-nya diedit (ARCHITECTURE.md bagian 6 poin 1).
  formVersionId String @map("form_version_id") @db.Uuid

  /// Key = field.id, value = jawaban. Diindeks GIN untuk filter per field.
  answers Json @db.JsonB

  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  ipAddress    String?  @map("ip_address") @db.Inet
  /// Origin/Referer website yang meng-embed form saat submit.
  sourceDomain String?  @map("source_domain")

  form        Form        @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)

  integrationLogs SubmissionIntegrationLog[]

  @@index([formId, submittedAt(sort: Desc)])
  @@index([formVersionId])
  @@index([answers(ops: JsonbPathOps)], type: Gin)
  @@map("submissions")
}

enum IntegrationLogType {
  sheet
  email

  @@map("integration_log_type")
}

enum IntegrationLogStatus {
  pending
  success
  failed

  @@map("integration_log_status")
}

model SubmissionIntegrationLog {
  id           String               @id @default(uuid(7)) @db.Uuid
  submissionId String               @map("submission_id") @db.Uuid
  type         IntegrationLogType
  status       IntegrationLogStatus @default(pending)
  /// Email tujuan (type=email) atau nama sheet tujuan (type=sheet).
  target       String?

  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message")
  syncedAt     DateTime? @map("synced_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Kunci idempotency: satu baris log per (submission, tipe, target).
  // Job yang di-retry meng-update baris ini (retry_count++), bukan menambah baris
  // baru — supaya tidak ada baris dobel di sheet / email terkirim dua kali.
  @@unique([submissionId, type, target])
  @@index([submissionId])
  @@index([status, type])
  @@map("submission_integration_logs")
}

// ---------------------------------------------------------------------------
// Integrasi & notifikasi
// ---------------------------------------------------------------------------

enum IntegrationType {
  google_sheet

  @@map("integration_type")
}

model Integration {
  id     String          @id @default(uuid(7)) @db.Uuid
  formId String          @map("form_id") @db.Uuid
  type   IntegrationType
  /// Contoh untuk google_sheet:
  /// { "spreadsheetId": "...", "sheetName": "Sheet1", "credentialRef": "default",
  ///   "columnMapping": { "field_001": "A" } }
  /// Hanya menyimpan *referensi* kredensial — kredensial aslinya tetap di env.
  config   Json    @db.JsonB
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, isActive])
  @@map("integrations")
}

enum NotificationTrigger {
  on_submit

  @@map("notification_trigger")
}

model NotificationRule {
  id      String              @id @default(uuid(7)) @db.Uuid
  formId  String              @map("form_id") @db.Uuid
  trigger NotificationTrigger @default(on_submit)

  /// Daftar email tujuan yang tetap.
  recipients String[] @default([])
  /// Tujuan dinamis berdasarkan jawaban, misal:
  /// { "rules": [{ "fieldId": "field_003", "operator": "equals",
  ///               "value": "opt_2", "recipients": ["sales@example.com"] }] }
  /// Dipakai berdampingan dengan `recipients` — hasil akhirnya digabung.
  recipientRules Json? @map("recipient_rules") @db.JsonB

  /// Menjadi foreign key ke tabel template email di Part 8.
  emailTemplateId String? @map("email_template_id")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, isActive])
  @@map("notification_rules")
}
