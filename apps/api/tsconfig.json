{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // node16 (bukan "Node" klasik) supaya field `exports` di package.json
    // dependency ikut dibaca — @casl/ability menaruh type-nya di sana.
    // apps/api tidak punya "type": "module", jadi tetap dikompilasi sebagai CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "declaration": false,
    // Config ini hanya untuk typecheck & editor; yang meng-emit adalah
    // tsconfig.build.json. noEmit di sini mencegah file .js nyasar ke prisma/.
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "test/**/*.ts",
    "prisma.config.ts",
    "jest.config.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
