{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // node16 (bukan "Node" klasik) supaya field `exports` di package.json
    // dependency ikut dibaca — @react-email/* dan @formz/shared menaruh
    // type-nya di sana dan tidak punya field `types` di akar.
    // apps/worker tidak punya "type": "module", jadi tetap dikompilasi ke CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    // Template email ditulis sebagai komponen React (React Email), jadi berkas
    // .tsx perlu dikompilasi tanpa import React manual.
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
